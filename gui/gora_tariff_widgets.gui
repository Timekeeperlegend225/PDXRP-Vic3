			tooltip = "[SelectLocalization( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('gora_tariffs_export_on_cooldown'), '(CFixedPoint)0' ), 'gora_tariffs_export_cooldown_tt', 'gora_tariffs_export_low_subventions_tt' )]"
			blockoverride "button_texture" { texture = "gfx/interface/icons/trade_icons/low_subvention.dds" }
			blockoverride "click" {
				enabled = "[GetScriptedGui('gora_tariffs_export_low_subventions').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetScriptedGui('gora_tariffs_export_low_subventions').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
		gora_tariff_button_export = {
			tooltip = "[SelectLocalization( GreaterThan_CFixedPoint( GetPlayer.MakeScope.ScriptValue('gora_tariffs_export_on_cooldown'), '(CFixedPoint)0' ), 'gora_tariffs_export_cooldown_tt', 'gora_tariffs_export_high_subventions_tt' )]"
			blockoverride "button_texture" { texture = "gfx/interface/icons/trade_icons/high_subvention.dds" }
			blockoverride "click" {
				enabled = "[GetScriptedGui('gora_tariffs_export_high_subventions').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetScriptedGui('gora_tariffs_export_high_subventions').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
		gora_tariff_button_export = {
